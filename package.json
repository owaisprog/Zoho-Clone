{
  "name": "business-os",
  "version": "0.1.0",
  "private": true,
  "description": "ChatGPT-led modular Business OS development workspace",
  "engines": { "node": ">=22.12.0" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev:web": "npm run dev --workspace @business-os/web",
    "dev:api": "npm run start:dev --workspace @business-os/api",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  }
}
