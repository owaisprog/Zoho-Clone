# P3.01 local synthetic-only API. Do not put secrets or real customer data here.
PORT=4000
HOST=127.0.0.1
NODE_ENV=development
# P3.07 approved ONLY for loopback demos: local or ci. Never set staging/production.
P3_APP_ENV=local
