{
  "name": "@zoho-clone/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Express API foundation: health check only, no customer-data routes",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "npm run prisma:generate && tsc --noEmit -p tsconfig.json",
    "test": "tsx --test test/*.test.ts",
    "prisma:generate": "prisma generate --schema db/schema.prisma && prisma generate --schema db/p4-v1-ci.prisma && prisma generate --schema db/p4-r7-ci.prisma",
    "smoke:synthetic-prisma": "node --env-file=.env.p3.runtime.local dist/scripts/p3-prisma-local-smoke.js",
    "smoke:synthetic-neon": "node --env-file=.env.neon.local dist/scripts/p3-prisma-neon-smoke.js",
    "prisma:validate:v1-ci": "prisma validate --schema db/p4-v1-ci.prisma",
    "prisma:validate:r7-ci": "prisma validate --schema db/p4-r7-ci.prisma"
  },
  "dependencies": {
    "@zoho-clone/demo-contracts": "*",
    "express-oauth2-jwt-bearer": "1.11.0",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "pg": "8.16.3",
    "bullmq": "5.81.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "prisma": "7.9.1",
    "@types/pg": "8.15.5"
  }
}
