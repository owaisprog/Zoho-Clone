# COPY TO frontend/.env.local, never commit the populated file.
# P3.07: Never prefix an Auth0 or DB secret with NEXT_PUBLIC_.
# Next.js includes NEXT_PUBLIC_ variables in client bundles; CI/build blocks secret-like names.
# Auth0 > Applications > Applications > Zoho Clone Development (Regular Web App)
AUTH0_DOMAIN=YOUR_TENANT.us.auth0.com
AUTH0_CLIENT_ID=YOUR_CLIENT_ID
AUTH0_CLIENT_SECRET=YOUR_CLIENT_SECRET
# Generate locally: openssl rand -hex 32
AUTH0_SECRET=PASTE_64_HEX_CHARACTERS_HERE
# Auth0 > Applications > APIs > Zoho Clone API > Identifier
# Must equal the Identifier configured at Auth0 > Applications > APIs.
# Owner created the Zoho Clone API using the below Identifier.
AUTH0_AUDIENCE=https://zoho-clone.vercel.app
APP_BASE_URL=http://localhost:3000
# Internal server-to-server Express only; never NEXT_PUBLIC_.
API_INTERNAL_URL=http://127.0.0.1:4000
